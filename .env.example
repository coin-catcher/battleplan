# Shared by local developers and Cursor cloud agents.
# Copy to .env and export the variables before deploying.

AWS_REGION=us-east-1
# Local developers: named profile for account 364807860961. Cloud agents leave this unset.
# After SSO login: aws sso login --profile TerraformPowerUser-364807860961
AWS_PROFILE=TerraformPowerUser-364807860961

# Filled in after the one-time bootstrap apply, or read from terraform output.
WARPLAN_TF_BUCKET=
WARPLAN_TF_LOCK_TABLE=

# Cursor Cloud Agents API key (Dashboard → API Keys, or a service account key).
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com

# Set to 1 to apply terraform without a prompt. Cloud agent deploys always apply.
# WARPLAN_AUTO_APPROVE=1
