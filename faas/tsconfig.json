{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["shared/src/**/*.ts", "projects/src/**/*.ts", "tasks/src/**/*.ts", "outputs/src/**/*.ts", "chat/src/**/*.ts", "agents/src/**/*.ts", "scripts/**/*.ts"]
}
